---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SOCIAL, daysFree } from '../lib/site';
import portrait from '../assets/brett-mount-lemmon.webp';
import aboutHero from '../assets/about-hero.webp';
const days = daysFree();
---

<Base title="About" description="What RC Journey is, and the person behind it.">
  {/* Hero */}
  <section class="relative">
    <div class="relative h-[46vh] min-h-[19rem] w-full overflow-hidden">
      <Image
        src={aboutHero}
        alt="A high-country overlook at golden hour"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0"
        style="background: linear-gradient(to top, rgb(var(--c-scrim) / 0.82) 0%, rgb(var(--c-scrim) / 0.35) 55%, rgb(var(--c-scrim) / 0.12) 100%);"
      >
      </div>
      <div class="absolute inset-x-0 bottom-0">
        <div class="mx-auto max-w-3xl px-5 pb-8 md:px-8 md:pb-10">
          <p class="eyebrow" style="color: #f0d9a8;">About · Day <span data-days-free>{days.toLocaleString('en-US')}</span> of freedom</p>
          <h1 class="title-display mt-3 text-5xl text-[#f7efe0] md:text-6xl">A travelogue with a purpose.</h1>
        </div>
      </div>
    </div>
  </section>

  {/* Intro — circular portrait + lead */}
  <section class="mx-auto max-w-3xl px-5 py-12 md:px-8">
    <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-center sm:gap-10">
      <Image
        src={portrait}
        alt="Brett on Mount Lemmon"
        width={416}
        height={416}
        class="h-40 w-40 shrink-0 rounded-full border border-line object-cover shadow-sm sm:h-52 sm:w-52"
      />
      <p class="text-lg leading-relaxed text-muted">
        The “RC” in RC Journey stands for <strong class="font-semibold text-ink">Returning
        Citizen</strong> — someone transitioning back into society after a period of incarceration.
        This is a space where the breathtaking beauty of the American West is held up against the
        honest, often unseen, realities of reentry.
      </p>
    </div>

    {/* Start here → the introduction article */}
    <a
      href="/rcj-intro/"
      class="group mt-10 block rounded-lg border border-line bg-surface p-6 no-underline transition-colors hover:border-ochre"
    >
      <p class="eyebrow">Start here</p>
      <p class="title-display mt-2 text-xl transition-colors group-hover:text-ochre">
        RC Journey: Where the Open Road Meets the Path Back Home<span aria-hidden="true" class="text-ochre"> →</span>
      </p>
      <p class="mt-1 text-muted">The introduction — what this is, and why it exists.</p>
    </a>
  </section>

  {/* Detail */}
  <section class="mx-auto max-w-3xl px-5 pb-12 md:px-8">
    <div class="prose-rcj">
      <h2>What RC Journey is</h2>
      <ul>
        <li><strong>A travelogue with a purpose.</strong> Cross-country travels through America’s
          landscapes — serene forests to majestic mountains — as a backdrop for reflection on
          resilience and the ongoing path of reentry.</li>
        <li><strong>A mirror to reentry realities.</strong> The systemic barriers and personal
          struggles returning citizens face daily: housing, employment, rebuilding relationships.</li>
        <li><strong>A personal narrative.</strong> My own road — from incarceration to a self-taught
          path into platform and DevOps engineering, and now an independent practice, traveler, and
          storyteller.</li>
      </ul>

      <h2>Meet Brett</h2>
      <p>
        My name is Brett. After 24 years of incarceration, I committed to a path of personal and
        professional growth. Self-taught and now independent, I run my own platform and DevOps
        consulting practice at <a href="https://brett-buskirk.dev">brett-buskirk.dev</a>. Working
        for myself gives me the flexibility to merge a passion for technology and travel with a
        commitment to the reentry community.
      </p>

      <h2>The mission</h2>
      <ul>
        <li><strong>Humanize reentry</strong> through authentic stories that break down stigma.</li>
        <li><strong>Inspire hope</strong> through narratives of successful reentry and the beauty of nature.</li>
        <li><strong>Educate and inform</strong> about the challenges of reentry and what helps.</li>
        <li><strong>Build community</strong> for returning citizens, their loved ones, and advocates.</li>
      </ul>
    </div>

    <hr class="horizon mt-12" />
    <p class="mt-8 flex flex-wrap gap-4">
      {SOCIAL.map((s) => (
        <a href={s.href} rel="me noopener" class="rounded-full border border-line px-4 py-2 font-mono text-xs uppercase tracking-widest no-underline hover:border-ochre">{s.label}</a>
      ))}
    </p>
  </section>
</Base>
